    "freq", ",", "ne0", ",", "B0", ",", "nz", ",", "nx", ",", "etaList", ",", 
     "TList", ",", "nminList", ",", "nmaxList", ",", "model1"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"nx", ",", 
     RowBox[{"rootsWarmH", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
