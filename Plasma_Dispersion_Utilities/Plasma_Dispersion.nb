Cell[CellGroupData[{

Cell["Numerical implementation of the Z function", "Section",
 CellMargins->{{Inherited, 107}, {Inherited, Inherited}},
 InitializationCell->True,
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"a030ab8b-101a-4b9b-945c-81a34a2bccf2"],

Cell["\<\
This implementation uses the representation in terms of error functions for \
small argument |z|<M and asymptotic expansion for argument |z| > M. Now M=4. 
Note: The choice of s in the asymptotic expansion is different from that \
given in the plasma formulary (their sigma).  Use of their sigma clearly \
doesn't work for example when Re[z] =0.  Then sigma must be 0 whereas their \
formula would have sigma=1.
Note (10/28/2022): Added If[Abs[z2]]] test to asymptotic expansion to \
eliminate underflow warnings.\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.875922006534795*^9, 3.875922007032234*^9}, {
   3.87596309817626*^9, 3.875963197743627*^9}, 3.875963380958317*^9, {
   3.8760643009982443`*^9, 3.8760643046287203`*^9}},
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"f784151b-f677-4c81-816a-99e009c93132"],

Cell[CellGroupData[{

Cell["Z function module", "Subsection",
 InitializationCell->True,
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"d04f9ef6-588c-4935-a60d-a7eb3cff61bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Zfun", "[", "z0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"M", "=", "4."}], ",", 
      RowBox[{"M2", "=", "100."}], ",", "s", ",", "y", ",", "q", ",", "z2"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"N", "[", "z0", "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "z", "]"}], "<", "M"}], ",", 
       RowBox[{"1.772453851", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          SuperscriptBox["z", "2"]}]], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Erf", "[", 
           RowBox[{"\[ImaginaryI]", " ", "z"}], "]"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"Im", "[", "z", "]"}]}], ";", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"y", "==", "0."}], ",", 
          RowBox[{"s", "=", "1"}], ",", 
          RowBox[{"y", ">", "0"}], ",", 
          RowBox[{"s", "=", "0"}], ",", 
          RowBox[{"y", "<", "0"}], ",", 
          RowBox[{"s", "=", "2"}]}], "]"}], ";", 
        RowBox[{"z2", "=", 
         SuperscriptBox["z", "2"]}], ";", 
        RowBox[{"q", "=", 
         FractionBox[
          RowBox[{"1", "+", 
           FractionBox["1", 
            RowBox[{"2", " ", "z2"}]], "+", 
           FractionBox["3", 
            RowBox[{"4", " ", 
             SuperscriptBox["z2", "2"]}]], "+", 
           FractionBox["15", 
            RowBox[{"8", " ", 
             SuperscriptBox["z2", "3"]}]], "+", 
           FractionBox[
            RowBox[{"7", " ", "15"}], 
            RowBox[{"16", " ", 
             SuperscriptBox["z2", "4"]}]]}], "z"]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "z2", "]"}], "<", "M2"}], ",", 
          RowBox[{
           RowBox[{"1.772453851", "*", "I", "*", "s", "*", 
            RowBox[{"E", "^", 
             RowBox[{"(", 
              RowBox[{"-", "z2"}], ")"}]}]}], "-", "q"}], ",", 
          RowBox[{"-", "q"}]}], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.875963047966688*^9, 3.875963072049201*^9}},
 ImageRegion->{{0, 1}, {0, 1}},
 CellLabel->
  "In[4182]:=",ExpressionUUID->"2d5aea52-7543-4306-b87e-ac59064df92e"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Warmgamma[freq, ne, B, nx, TList] \[Dash] Gamma parameter of warm plasma \
theory \[CapitalGamma]=1/2 (k",
 StyleBox["\[UpTee]",
  FontVariations->{"CompatibilityType"->"Subscript"}],
 "\[Rho])^2\nReturns a list of length TList with an element for each species"
}], "Section",
 CellChangeTimes->{{3.975073653497507*^9, 3.9750736577575827`*^9}, {
  3.9750737287450867`*^9, 3.975073777539723*^9}},
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"57a10521-2262-47b1-a3b5-bfe7ff987578"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Warmgamma", "[", 
   RowBox[{"freq_", ",", "B_", ",", "nx_", ",", "TList_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fc", ",", "v", ",", "gamma"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", "0", "]"}], "=", "1."}], ";", 
     RowBox[{"gamma", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "TList", "]"}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fc", "=", 
         RowBox[{
          RowBox[{"CyclotronFreqHzMKS", "[", 
           RowBox[{"i", ",", "B"}], "]"}], "/", 
          SuperscriptBox["10", "6"]}]}], ";", 
        RowBox[{"v", "=", 
         RowBox[{"VthOverC", "[", 
          RowBox[{"i", ",", 
           RowBox[{"T", "[", "i", "]"}]}], "]"}]}], ";", 
        RowBox[{
         RowBox[{
         "gamma", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"nx", " ", "freq", " ", "v"}], "fc"], ")"}], "2"], 
          "2."]}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "TList", "]"}]}], "}"}]}], "]"}], ";", 
     "gamma"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.8758030899970703`*^9, 3.901632484376713*^9, {3.993034701811297*^9, 
   3.993034724571927*^9}, {3.9930369058300953`*^9, 3.993036914515135*^9}, {
   3.993043658131378*^9, 3.993043672081235*^9}},
 ImageRegion->{{0, 1}, {0, 1}},
 CellLabel->
  "In[4183]:=",ExpressionUUID->"e3b5e8ba-def4-4266-b432-7232a0e5fe7f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
SRLDP[freq, ne, B, etaList] \[Dash] S,R.L,D & P functions of cold plasma \
theory\
\>", "Section",
 CellChangeTimes->{{3.9750735818128633`*^9, 3.975073607241294*^9}, 
   3.975073815011306*^9},
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"31393097-713b-44b9-93c7-91fe568e06b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SRLDP", "[", 
   RowBox[{"freq_", ",", "ne_", ",", "B_", ",", "etaList_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n0", ",", "B0", ",", "eta", ",", "mass", ",", "chg", ",", "fp", ",", 
      "fc", ",", "R", ",", "L", ",", "S", ",", "d", ",", "P"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", "1", "]"}], "=", "1."}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eta", "[", "i", "]"}], "=", 
        RowBox[{"etaList", "\[LeftDoubleBracket]", 
         RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "6"}], "}"}]}], "]"}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fp", "[", "i", "]"}], "=", 
        RowBox[{
         RowBox[{"PlasmaFreqHzMKS", "[", 
          RowBox[{"i", ",", "ne", ",", 
           RowBox[{"eta", "[", "i", "]"}]}], "]"}], "/", 
         SuperscriptBox["10", "6"]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fc", "[", "i", "]"}], "=", 
        RowBox[{
         RowBox[{"CyclotronFreqHzMKS", "[", 
          RowBox[{"i", ",", "B"}], "]"}], "/", 
         SuperscriptBox["10", "6"]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "5"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"fp", "[", "i", "]"}], "2"], 
         RowBox[{"freq", " ", 
          RowBox[{"(", 
           RowBox[{"freq", "+", 
            RowBox[{"fc", "[", "i", "]"}]}], ")"}]}]]}]}]}], ";", 
     RowBox[{"L", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "6"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"fp", "[", "i", "]"}], "2"], 
         RowBox[{"freq", " ", 
          RowBox[{"(", 
           RowBox[{"freq", "-", 
            RowBox[{"fc", "[", "i", "]"}]}], ")"}]}]]}]}]}], ";", 
     RowBox[{"S", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "6"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"fp", "[", "i", "]"}], "2"], 
         RowBox[{
          SuperscriptBox["freq", "2"], "-", 
          SuperscriptBox[
           RowBox[{"fc", "[", "i", "]"}], "2"]}]]}]}]}], ";", 
     RowBox[{"P", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "6"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"fp", "[", "i", "]"}], "2"], 
         SuperscriptBox["freq", "2"]]}]}]}], ";", 
     RowBox[{"d", "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "6"], 
       RowBox[{
        FractionBox[
         RowBox[{"fc", "[", "i", "]"}], "freq"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"fp", "[", "i", "]"}], "2"], 
         RowBox[{
          SuperscriptBox["freq", "2"], "-", 
          SuperscriptBox[
           RowBox[{"fc", "[", "i", "]"}], "2"]}]]}]}]}], ";", 
     RowBox[{"{", 
      RowBox[{"S", ",", "R", ",", "L", ",", "d", ",", "P"}], "}"}]}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.788800280909318*^9, 3.788800281972652*^9}, 
   3.875802889731574*^9, 3.875803081788562*^9, {3.976459682728517*^9, 
   3.97645969585198*^9}, {3.993036977368887*^9, 3.9930370004049873`*^9}, {
   3.993037066363825*^9, 3.9930370830263453`*^9}, 3.9930371788346777`*^9, {
   3.993037306017993*^9, 3.993037375918867*^9}, 3.993040446932056*^9, {
