               FractionBox[
                RowBox[{
                "Z", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
                "2"]}], ",", 
              RowBox[{"2", " ", 
               RowBox[{
               "z", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{
                  "z", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   " ", 
                  RowBox[{
                  "Z", "\[LeftDoubleBracket]", "3", 
                   "\[RightDoubleBracket]"}]}]}], ")"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
                RowBox[{
                "Z", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
                "+", 
               RowBox[{
                FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
