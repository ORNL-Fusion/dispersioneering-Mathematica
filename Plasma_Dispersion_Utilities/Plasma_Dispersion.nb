 RowBox[{
  RowBox[{"nSqAppletonHartreeOX", "[", 
   RowBox[{
   "freq_", ",", "ne_", ",", "B_", ",", "\[Theta]_", ",", "etaList_List"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "R", ",", "L", ",", "S", ",", "P", ",", "a", ",", "b", ",", "c", ",", 
      "d", ",", "discr", ",", "rootO", ",", "rootX"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"srldp", "=", 
      RowBox[{"SRLDP", "[", 
       RowBox[{"freq", ",", "ne", ",", "B", ",", "etaList"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"S", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
