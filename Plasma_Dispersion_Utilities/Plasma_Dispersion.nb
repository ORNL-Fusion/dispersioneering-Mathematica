   3.976454818343481*^9}, {3.97645486036067*^9, 3.976454889446443*^9}, {
   3.976455643119474*^9, 3.976455644662711*^9}, {3.976455771185174*^9, 
   3.9764557758717403`*^9}, {3.9764558647237797`*^9, 3.976455879085843*^9}, {
   3.9764559994598417`*^9, 3.9764560322504673`*^9}, {3.976456080969195*^9, 
   3.9764560814951773`*^9}, {3.976456626883594*^9, 3.976456632363677*^9}, {
   3.976459454370578*^9, 3.9764595285650578`*^9}, {3.976460227881908*^9, 
