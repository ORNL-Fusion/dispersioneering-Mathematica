       RowBox[{"S", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
       RowBox[{"P", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", " ", 
      RowBox[{
       RowBox[{"R", " ", "L", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", " ", 
       RowBox[{"P", " ", "S", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
