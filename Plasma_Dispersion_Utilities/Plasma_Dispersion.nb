Cell[TextData[{
 "FullDisFunc[freq, ne, B, nz, etaList, TList, nminList, nmaxList] \[Dash] \
Numerical Implementation of full Warm Plasma Dispersion function \n\nUses \
WarmEpsMaxwell[ ] to calculate the dispersion tensor eps  , a list of length \
6 in the order :\neps{xx,yy,zz,xy,xz,yz}\n\n Returns complex value of \
dispersion function.\n N.B.  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Normalized", " ", "by", " ", "wave", " ", 
      RowBox[{"frequency", "/", "electron"}], " ", "plasma", " ", 
      "frequency"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "bbaf57c1-3b5b-49d5-aa0d-3ae8ec94c50c"]
}], "Subsection",
 InitializationCell->True,
