           RowBox[{"3", ",", "4"}], "\[RightDoubleBracket]"}], "2"], "+", 
         RowBox[{
          RowBox[{"eps", "\[LeftDoubleBracket]", 
           RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}], " ", 
          SuperscriptBox[
           RowBox[{"eps", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "4"}], "\[RightDoubleBracket]"}], "2"]}]}]}], 
       "}"}]}], ";", 
     RowBox[{"eq", "=", 
      RowBox[{"coeffs", ".", 
       RowBox[{"{", 
