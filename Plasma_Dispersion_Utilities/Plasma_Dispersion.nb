Cell[CellGroupData[{

Cell["\<\
nxBookerQ[freq, ne, B, ny, nz, \[Theta]]  Solve Booker quartic using NSolve[] \
.  Electron dynamics only.  Returns list of length 4 with nx roots.  Makes no \
attempt to sort the roots.\
\>", "Subsection",
 CellChangeTimes->{{3.975340587117486*^9, 3.9753406261890383`*^9}, {
  3.976464057228744*^9, 3.976464085469556*^9}, {3.976464131741334*^9, 
  3.976464208259062*^9}},ExpressionUUID->"fb4c3e86-4c82-4b19-b679-\
a269ec1ea632"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nxBookerQ", "[", 
    RowBox[{
    "freq_", ",", "ne_", ",", "B_", ",", "ny_", ",", "nz_", ",", 
     "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "fc", ",", "X", ",", " ", "Y"}], "}"}], ",", 
     RowBox[{
      RowBox[{"eta", "=", "1."}], ";", 
      RowBox[{"fp", "=", 
       RowBox[{
        RowBox[{"PlasmaFreqHzMKS", "[", 
         RowBox[{"1", ",", "ne", ",", 
          RowBox[{"eta", "[", "1", "]"}]}], "]"}], "/", 
        SuperscriptBox["10", "6"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fc", "=", 
       RowBox[{
        RowBox[{"CyclotronFreqHzMKS", "[", 
         RowBox[{"1", ",", "B"}], "]"}], "/", 
        SuperscriptBox["10", "6"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"X", "=", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"fp", "/", "freq"}], ")"}], "2"]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Y", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"fc", "/", "freq"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<X = \>\"", ",", "X", ",", "\"\<   Y = \>\"", ",", "Y", ",", 
          "\"\<   fp = \>\"", ",", "fp", ",", "\"\<   fc = \>\"", ",", "fc"}],
          " ", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rootrules", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BookerDisFunc", "[", 
           RowBox[{
           "nx", ",", "X", ",", "Y", ",", "ny", ",", "nz", ",", "\[Theta]"}], 
           "]"}], "\[Equal]", "0"}], ",", "nx"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"nx", "/.", 
         RowBox[{"rootrules", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8636334384687243`*^9, 3.8636334535671177`*^9}, {
   3.863633826189492*^9, 3.863633826548345*^9}, 3.875803898660796*^9, 
