   RowBox[{"fp_", ",", "fc_", ",", "f_", ",", "v_", ",", "nz_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"z", ",", "Z", ",", "b", ",", "sigma"}], "}"}], ",", 
    RowBox[{
     RowBox[{"b", "=", 
      FractionBox["fc", "f"]}], ";", 
     RowBox[{"z", "=", 
      FractionBox[
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "b"}]}], ",", 
