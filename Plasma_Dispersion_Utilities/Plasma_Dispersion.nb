ad04f610f7d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclotronFreqHzMKS", "[", 
   RowBox[{"i_", ",", "B_", ",", 
    RowBox[{"print_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mass", ",", "chg", ",", "fp", ",", "clight", ",", "mu0", ",", "eps0", 
      ",", "e", ",", "ns", ",", "omc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"clight", "=", 
      RowBox[{"2.997930", "\[Times]", 
       SuperscriptBox["10", "8"]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mu0", "=", 
      RowBox[{"\[Pi]", "*", "4.0", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "7"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", 
      RowBox[{"1.6022", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "19"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"me", "=", 
      RowBox[{"9.1094", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "31"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eps0", "=", 
      RowBox[{"1.", "/", 
       RowBox[{"(", 
        RowBox[{"mu0", "*", 
         SuperscriptBox["clight", "2"]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mass", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1.", ",", "1836.", ",", "3670.", ",", "5497.", ",", "5496.", ",", 
         "7294"}], "}"}], "me"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"chg", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1."}], ",", "1.", ",", "1.", ",", "1.", ",", "2.", ",",
          "2."}], "}"}], "e"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"omc", "=", 
      RowBox[{
       RowBox[{"chg", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"B", "/", 
        RowBox[{"mass", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "\[Pi]"}]], "omc"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"print", "\[Equal]", "True"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(f\), \(cs\)]\)=\>\"", ",", 
         RowBox[{"Chop", "[", "fc", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "fc"}]}], "]"}]}]], "Input",
 InitializationCell->True,
