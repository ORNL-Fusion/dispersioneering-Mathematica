 ") {+ root, - root}"
}], "Subsection",
 CellChangeTimes->{
  3.8629549281469*^9, {3.8629549668270407`*^9, 3.862955020616287*^9}, 
   3.97499160064631*^9, {3.974991996541415*^9, 3.9749920177548656`*^9}, 
