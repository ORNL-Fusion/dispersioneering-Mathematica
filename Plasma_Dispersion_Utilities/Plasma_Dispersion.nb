         RowBox[{"1", "-", 
          RowBox[{"2", " ", "b"}]}]}], "}"}], 
       RowBox[{"nz", " ", "v"}]]}], ";", 
     RowBox[{"Z", "=", 
      RowBox[{"Zfun", "/@", "z"}]}], ";", 
     RowBox[{"sigma", "=", 
