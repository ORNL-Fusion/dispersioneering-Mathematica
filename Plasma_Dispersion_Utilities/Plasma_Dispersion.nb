relation for fast wave (i.e. Ez=0) ColdDis0[ ]\nReturns nx(nz) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SqrtBox[
     StyleBox[
      RowBox[{"n", 
       StyleBox["x",
        FontVariations->{"CompatibilityType"->"Subscript"}], 
       StyleBox["2",
        FontVariations->{"CompatibilityType"->"Superscript"}]}]]]}], 
