Cell[CellGroupData[{

Cell["\<\
nAppletonHartreeOX[freq, ne ,B, \[Theta], etaList_List] Appleton-Hartree \
solver.  Returns n(\[Theta]) \[RightArrow] {O-mode, X-mode}\
\>", "Subsection",
 CellChangeTimes->{
  3.8629549281469*^9, {3.8629549668270407`*^9, 3.862955020616287*^9}, {
   3.863633489229774*^9, 3.863633503517734*^9}, {3.974991950673814*^9, 
   3.9749919701367893`*^9}, 3.97499210838743*^9, {3.975073122973238*^9, 
   3.975073178962625*^9}, {3.9751490337724543`*^9, 3.97514903465736*^9}, {
   3.9751491858126802`*^9, 3.9751492371880627`*^9}, {3.975235117807974*^9, 
   3.975235118422928*^9}, {3.975235184646716*^9, 3.975235208816691*^9}, {
   3.976452412312764*^9, 3.976452429427753*^9}, {3.976461550534422*^9, 
   3.976461600742867*^9}, {3.9764616379171333`*^9, 3.976461656697523*^9}, {
   3.976461693897084*^9, 3.9764617332970247`*^9}, {3.976464119638934*^9, 
   3.976464124157076*^9}, 3.976552694367774*^9},
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"8e5df309-a05d-48f9-bba4-3d71432ffb4a"],

Cell[TextData[{
 "N . B .  Stix (Eq 1-29) defines b as negative of the usual quadratic \
eqation b.  i.e. A",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "4"], "-", " ", 
     SuperscriptBox["Bn", 
      RowBox[{"2", " "}]], "+", "C"}], " ", "=", 
    RowBox[{"0.", "  ", "This", " "}]}], TraditionalForm]],ExpressionUUID->
  "e6307120-a32a-47fd-a74e-692229267201"],
 "has the effect of making O-mode correspond to + discr below, and X-mode \
correspond to - discr."
}], "Text",
 CellChangeTimes->{{3.980859998821252*^9, 3.980860249313459*^9}, {
  3.9808602921365833`*^9, 
  3.980860347425387*^9}},ExpressionUUID->"7fac0985-34c0-4ba4-9597-\
30f5d82784a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nAppletonHartreeOX", "[", 
   RowBox[{
   "freq_", ",", "ne_", ",", "B_", ",", "\[Theta]_", ",", "etaList_List"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "R", ",", "L", ",", "S", ",", "P", ",", "a", ",", "b", ",", "c", ",", 
      "d", ",", "discr", ",", "rootO", ",", "rootX"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"srldp", "=", 
      RowBox[{"SRLDP", "[", 
       RowBox[{"freq", ",", "ne", ",", "B", ",", "etaList"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"S", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"srldp", "[", 
       RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{"S", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
       RowBox[{"P", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", " ", 
      RowBox[{
       RowBox[{"R", " ", "L", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", " ", 
       RowBox[{"P", " ", "S", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"P", " ", "R", " ", "L"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"discr", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"R", " ", "L"}], "-", 
            RowBox[{"P", " ", "S"}]}], ")"}], "2"], 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "4"]}], "+", 
        RowBox[{"4", 
         SuperscriptBox["P", "2"], 
         SuperscriptBox["d", "2"], 
         SuperscriptBox[
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rootO", "=", 
      FractionBox[
       RowBox[{"b", "+", "discr"}], 
       RowBox[{"2", " ", "a"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootX", "=", 
      FractionBox[
       RowBox[{"b", "-", "discr"}], 
       RowBox[{"2", " ", "a"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       SqrtBox["rootO"], ",", 
       SqrtBox["rootX"]}], "}"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8636334384687243`*^9, 3.8636334535671177`*^9}, {
   3.863633826189492*^9, 3.863633826548345*^9}, 3.875803898660796*^9, 
   3.8758039297571573`*^9, {3.975149195254074*^9, 3.975149196678761*^9}, 
