function, electrons only. \n",
 Cell[BoxData[
  RowBox[{"X", "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubscriptBox["\[Omega]", "pe"], "\[Omega]"], ")"}], "2"]}]],
