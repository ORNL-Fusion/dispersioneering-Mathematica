   3.9928711615118847`*^9}, {3.9928713081491337`*^9, 3.992871331941506*^9}, {
   3.9928713751568747`*^9, 3.992871395677083*^9}, {3.992871462907474*^9, 
   3.9928714802899933`*^9}, {3.992871528546026*^9, 3.992871530030107*^9}, {
