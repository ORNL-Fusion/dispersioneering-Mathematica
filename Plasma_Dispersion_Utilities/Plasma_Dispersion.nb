Cell[BoxData[
 RowBox[{
  RowBox[{"VthOverC", "[", 
   RowBox[{"i_", ",", "TkeV_", ",", 
    RowBox[{"print_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mass", ",", "clight", ",", "me", ",", "e", ",", "Tjoule", ",", "v"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"clight", "=", 
      RowBox[{"2.997930", "\[Times]", 
       SuperscriptBox["10", "8"]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"me", "=", 
      RowBox[{"9.1094", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "31"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eKeV", "=", 
      RowBox[{"1.6022", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "16"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mass", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1.", ",", "1836.", ",", "3670.", ",", "5497.", ",", "5496.", ",", 
         "7294"}], "}"}], "me"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Tjoule", "=", 
      RowBox[{"eKeV", " ", "TkeV"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{
       FractionBox["1", "clight"], 
       SqrtBox[
        FractionBox[
         RowBox[{"2", " ", "Tjoule"}], 
         RowBox[{"mass", "[", 
          RowBox[{"[", "i", "]"}], "]"}]]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"print", "\[Equal]", "True"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(v\), \(th\)]\) = \>\"", ",", 
         RowBox[{"Chop", "[", "v", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "v"}]}], "]"}]}]], "Input",
